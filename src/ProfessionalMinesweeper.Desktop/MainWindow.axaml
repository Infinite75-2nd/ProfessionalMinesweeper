<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProfessionalMinesweeper.Desktop"
        x:Class="ProfessionalMinesweeper.Desktop.MainWindow"
        Title="Professional Minesweeper"
        Icon="/Assets/AppIcon.ico"
        Width="900" Height="680"
        MinWidth="420" MinHeight="360"
        CanResize="true"
        Background="#EDF2F6">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="游戏 (_Game)">
                <MenuItem Header="新游戏 (_New)" Name="MenuNewGame" InputGesture="F2"/>
                <Separator/>
                <MenuItem Header="初级" Name="MenuBeginner"/>
                <MenuItem Header="中级" Name="MenuIntermediate"/>
                <MenuItem Header="高级" Name="MenuExpert"/>
                <Separator/>
                <MenuItem Header="退出 (_Exit)" Name="MenuExit"/>
            </MenuItem>
            <MenuItem Header="棋盘 (_Board)">
                <MenuItem Header="经典方格" Name="MenuBoard20"/>
                <MenuItem Header="六边形" Name="MenuBoard21"/>
                <MenuItem Header="六边形（错位）" Name="MenuBoard28"/>
                <MenuItem Header="八边形方格" Name="MenuBoard22"/>
                <MenuItem Header="三角形" Name="MenuBoard23"/>
                <MenuItem Header="三角形（错位）" Name="MenuBoard26"/>
                <MenuItem Header="拼花地板" Name="MenuBoard24"/>
                <MenuItem Header="鱼骨拼花" Name="MenuBoard25"/>
                <MenuItem Header="地板" Name="MenuBoard27"/>
                <MenuItem Header="砖墙" Name="MenuBoard31"/>
                <MenuItem Header="交叉方格" Name="MenuBoard29"/>
                <MenuItem Header="60° 圆形" Name="MenuBoard30"/>
                <MenuItem Header="90° 圆形" Name="MenuBoard32"/>
                <MenuItem Header="五边形" Name="MenuBoard33"/>
                <MenuItem Header="5,7 镶嵌" Name="MenuBoard34"/>
                <MenuItem Header="斜 H" Name="MenuBoard35"/>
                <MenuItem Header="正五边形" Name="MenuBoard36"/>
                <MenuItem Header="菱形" Name="MenuBoard37"/>
                <MenuItem Header="碎晶（自研）" Name="MenuSunflower"/>
                <MenuItem Header="漩涡（自研）" Name="MenuVortex"/>
                <Separator/>
                <MenuItem Header="自定义棋盘 (_Custom)..." Name="MenuCustomBoard"/>
            </MenuItem>
            <MenuItem Header="帮助 (_Help)" Name="MenuHowToPlay"/>
            <MenuItem Header="深色主题" Name="MenuTheme"/>
            <MenuItem Header="关于" Name="MenuAbout"/>
        </Menu>

        <Border Name="StatusPanel" DockPanel.Dock="Top" Background="#FFFFFF" CornerRadius="10" Padding="12" Margin="12" BorderBrush="#D4DFE8" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14">
                <TextBlock Name="ModeLabelText" Text="模式: Classical (初级)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Background="Black" CornerRadius="3" Padding="6,2">
                    <TextBlock Name="MinesCountText" Text="010" Foreground="#FF4040" FontFamily="Consolas, Monospace" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </Border>
                <Button Name="ResetButton" Content="😊" FontSize="20" Padding="10,2" VerticalAlignment="Center"/>
                <Border Background="Black" CornerRadius="3" Padding="6,2">
                    <TextBlock Name="TimerText" Text="000" Foreground="#FF4040" FontFamily="Consolas, Monospace" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="缩放" VerticalAlignment="Center"/>
                    <Slider Name="ZoomSlider" Minimum="25" Maximum="400" Value="100" Width="110"/>
                    <TextBlock Name="ZoomText" Text="100%" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Name="BoardPanel" Margin="12,0,12,12" Background="#D8E1E8" BorderBrush="#AABAC7" BorderThickness="1" CornerRadius="10">
            <local:DesktopBoardViewport Name="BoardViewport"/>
        </Border>
    </DockPanel>
</Window>
